# Railway exposes TWO separate internal listeners.
# The public TCP proxy address and port come from Railway Settings > Networking.
HTTP_PORT=8080
TCP_PORT=5000
# Set these to the CURRENT public TCP Proxy host and EXTERNAL port from Railway.
# These values are displayed for diagnostics; they cannot configure Railway by themselves.
TCP_PUBLIC_HOST=
TCP_PUBLIC_PORT=
TCP_IDLE_TIMEOUT_SECONDS=300
TCP_MAX_PACKET_BYTES=1048576
TCP_MAX_SESSIONS=1000
